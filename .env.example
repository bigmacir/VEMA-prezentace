# Heslo obchodníka – sestavení prezentace, náhled, export PPTX/MP4
USER_PASSWORD=zmente-heslo-obchodnika
# Heslo administrátora – navíc úpravy knihovny obsahu
ADMIN_PASSWORD=zmente-heslo-admina
# Náhodný řetězec pro podpis přihlašovací cookie (např. openssl rand -hex 32)
SESSION_SECRET=
# Délka přihlášení v hodinách (výchozí 12)
SESSION_HOURS=12
DATA_DIR=/data
DOMAIN=prezenter.example.cz

# ---- Kvalitnější hlasy (volitelné; bez klíče se nabízí jen Edge TTS) ----
# ElevenLabs: klíč z elevenlabs.io → Profile → API keys.
# Hlasy: "Jméno:voice_id" oddělené čárkou (voice_id z Voice Library → "Copy voice ID").
ELEVENLABS_API_KEY=
ELEVENLABS_VOICES=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Google Cloud TTS (Chirp 3: HD): API klíč s povoleným Cloud Text-to-Speech API.
GOOGLE_TTS_API_KEY=
# GOOGLE_TTS_VOICES=Aoede – žena:cs-CZ-Chirp3-HD-Aoede,Charon – muž:cs-CZ-Chirp3-HD-Charon
# GOOGLE_TTS_ENDPOINT=https://eu-texttospeech.googleapis.com
